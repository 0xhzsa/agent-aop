{
  "name": "handoff-validator",
  "version": "0.1.0",
  "description": "Agent Handoff Validator — validates whether two AI agent frameworks can hand off work via AOP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "handoff-validator": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
